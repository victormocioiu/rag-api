# CNPG app-user DSN from the rag-pg secret (edka databases view).
# Inject via the edka ENVS tab; the -rw service is the writable primary.
DATABASE_URL=postgresql://app:CHANGEME@rag-pg-rw.postgres.svc.cluster.local:5432/app

# In-cluster embedder; queries embed with input_type="query".
EMBEDDER_URL=http://rag-embedder.rag.svc.cluster.local

SEARCH_K=8
SEARCH_CANDIDATES=50
DEFAULT_TENANT_SLUG=default
